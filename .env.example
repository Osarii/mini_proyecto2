# ==============================================================================
# CONFIGURACIÓN DEL PORTAL DE RRHH CON RAG MULTIAGENTE
# Innovatech Solutions S.A.
# ==============================================================================

# Puerto de la API del servidor backend
PORT=3001

# Proveedor principal de LLM para el chat ('deepseek', 'openai' o 'gemini')
LLM_PROVIDER=deepseek

# Clave de API de DeepSeek (para respuestas del chat con DeepSeek-V3 / DeepSeek-R1)
DEEPSEEK_API_KEY=tu_api_key_de_deepseek_aqui
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Clave de API de OpenAI (opcional)
OPENAI_API_KEY=tu_api_key_de_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# Clave de API de Google Gemini (opcional o de respaldo)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Umbral de similitud para recuperación de políticas (0.0 a 1.0)
# Si la similitud cae por debajo, el RAG ofrece derivar a RRHH
SIMILARITY_THRESHOLD=0.62

# Ruta de la base de datos SQLite (se genera automáticamente)
DB_PATH=./backend/rrhh_portal.db

# Ruta local de documentos sincronizados con Google Drive
DRIVE_POLICIES_DIR=./politicas_drive

# Integración opcional directa con Google Cloud Console y Drive API v3
# Reutilizable con la cuenta de servicio del Mini Proyecto #1
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service_account.json
GOOGLE_DRIVE_FOLDER_ID=tu_id_de_carpeta_de_drive_aqui

# Programación del Agente Analista (cron format: diario a las 7:00 a. m.)
REPORT_CRON_SCHEDULE=0 7 * * *

# Destinatario de notificaciones de RRHH y configuración SMTP
HR_NOTIFICATION_EMAIL=rrhh@tuempresa.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion
SMTP_FROM="Portal de RRHH Innovatech" <notificaciones@innovatech.cr>
